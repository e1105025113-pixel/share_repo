<?xml version="1.0"?>
<robot name="my_robot">
<!-- 本体 -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
    </visual>
  </link>
<!-- 左車輪 -->
  <link name="left_wheel">
    <visual>
     <geometry>
      <cylinder radius="0.15" length="0.1"/>
     </geometry>
    </visual>
   </link>
<!-- 右車輪  -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.1"/>
      </geometry>
    </visual>
  </link>
<!-- 本体から左車輪  -->
  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.35 -0.15" rpy="1.5708 0 0"/>
  </joint>
<!-- 本体から右車輪 -->
  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.35 -0.15" rpy="1.5708 0 0"/>
  </joint>
<!--　レーザー -->
  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.1"/>
      </geometry>
    </visual>
  </link>
<!-- 本体からレーザー -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>
</robot>
