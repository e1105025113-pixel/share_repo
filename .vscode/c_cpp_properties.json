{
    "configurations": [
        {
            "name": "ros2",
            "includePath": [
                "/opt/ros/jazzy/include/**",
                "${workspaceFolder}/src/**"
            ],
            "browse": {
                "path": [
                    "/opt/ros/jazzy/include",
                    "${workspaceFolder}/src"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "intelliSenseMode": "gcc-x64",
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu11",
            "cppStandard": "c++17"
        }
    ],
    "version": 4
}